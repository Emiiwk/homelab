# ============================================================
# homelab - plantilla de variables de entorno
# Copia a .env y rellena. NUNCA subas .env a GitHub.
# ============================================================

# --- Identidad del laboratorio ---
COMPOSE_PROJECT_NAME=homelab
DOMAIN=homelab.local
REALM=HOMELAB.LOCAL
DC_HOSTNAME=dc01
AD_ADMIN_PASSWORD=CAMBIAR_ADMIN_PASSWORD
AD_DNS_FORWARDER=1.1.1.1

# --- Red ---
LAN_SUBNET=192.168.0.0/24
DOCKER_SUBNET=10.10.0.0/16

# --- Tailscale ---
# Genera una clave en https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-CAMBIAR
TS_HOSTNAME=homelab
TS_ROUTES=10.10.0.0/16,192.168.0.0/24
TAILNET=tu-tailnet.ts.net

# --- GLPI ---
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=CAMBIAR_GLPI_DB_PASSWORD
GLPI_DB_ROOT_PASSWORD=CAMBIAR_MARIADB_ROOT_PASSWORD
GLPI_TIMEZONE=Europe/Madrid
GLPI_API_TOKEN=CAMBIAR_GLPI_API_TOKEN
GLPI_USER=glpi
GLPI_PASSWORD=glpi
GLPI_URL=http://glpi.homelab.${TAILNET}

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_GRAFANA_PASSWORD

# --- Backups ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# --- Flags de aprovisionamiento ---
SEED_GLPI_TICKETS=true
SEED_AD_USERS=true
